{
  "name": "ats-jobs-api",
  "version": "1.0.0",
  "private": true,
  "description": "Normalized open jobs from public ATS job boards (Greenhouse, Lever, Ashby, SmartRecruiters, Workable, Recruitee) as a Cloudflare Worker.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build:test": "esbuild src/index.ts --bundle --format=esm --platform=neutral --outfile=dist/worker.mjs --log-level=warning",
    "test": "npm run build:test && node --test test/unit.test.mjs",
    "bench": "npm run build:test && node --expose-gc test/bench.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.164.0",
    "esbuild": "^0.24.0"
  }
}
